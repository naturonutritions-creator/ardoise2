# Base de données (PostgreSQL) — ex. Vercel Postgres, Neon, Supabase, Railway...
DATABASE_URL="postgres://user:password@host:5432/ardoise"

# NextAuth — génère une valeur avec: openssl rand -base64 32
NEXTAUTH_SECRET="change-moi"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (mode test puis live)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MENSUEL=""
STRIPE_PRICE_ANNUEL=""
STRIPE_PRICE_FAMILLE=""

# URL publique du site (utilisée pour les redirections Stripe en fallback)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
